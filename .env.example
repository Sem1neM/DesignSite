# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не должен попадать в git (уже в .gitignore).

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/design_db
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=design_db

# --- Security ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- OpenAI (для ИИ-агента уточнения ТЗ) ---
OPENAI_API_KEY=

# --- Telegram ---
# Получить у @BotFather. Оставьте пустым, чтобы бот не запускался.
TELEGRAM_BOT_TOKEN=

# --- Application ---
DEBUG=False
